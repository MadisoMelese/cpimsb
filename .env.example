# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://cpims_user:CHANGE_ME@localhost:5432/cpims_db?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Processing loss acceptable range ───────────────────────────────────────────
PROCESSING_LOSS_MIN_PCT=0
PROCESSING_LOSS_MAX_PCT=30
