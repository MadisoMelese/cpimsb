{
  "name": "cpims-backend",
  "version": "1.0.0",
  "description": "Coffee Production and Inventory Management System — Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev":                   "nodemon src/server.js",
    "start":                 "node src/server.js",
    "lint":                  "eslint src --ext .js",
    "lint:fix":              "eslint src --ext .js --fix",
    "format":                "prettier --write \"src/**/*.{js,json}\"",
    "prisma:generate":       "prisma generate",
    "prisma:migrate":        "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio":         "prisma studio",
    "prisma:seed":           "node src/database/seed.js",
    "test":                  "jest --selectProjects unit adversarial concurrency --runInBand",
    "test:unit":             "jest --selectProjects unit --runInBand",
    "test:adversarial":      "jest --selectProjects adversarial --runInBand",
    "test:concurrency":      "jest --selectProjects concurrency --runInBand",
    "test:integration":      "jest --selectProjects integration --runInBand",
    "test:all":              "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client":     "6.16.2",
    "bcryptjs":           "2.4.3",
    "compression":        "1.7.4",
    "cors":               "2.8.5",
    "dotenv":             "16.4.5",
    "express":            "4.19.2",
    "express-rate-limit": "7.3.1",
    "helmet":             "7.1.0",
    "jsonwebtoken":       "9.0.2",
    "pino":               "9.2.0",
    "pino-pretty":        "11.2.1",
    "swagger-ui-express": "5.0.1",
    "uuid":               "10.0.0",
    "yamljs":             "0.3.0",
    "zod":                "3.23.8"
  },
  "devDependencies": {
    "eslint":                 "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest":                   "29.7.0",
    "jest-serial-runner":     "1.2.1",
    "nodemon":                "3.1.9",
    "prettier":               "3.3.3",
    "prisma":                 "6.16.2",
    "supertest":              "7.0.0"
  }
}